# =============================================================
# Bêta Arsenal - Exemple de variables d'environnement
# =============================================================
# Copiez ce fichier vers `.env` (utilisé par scripts/seed.mjs et
# scripts/create-admin.mjs). Ne committez jamais le fichier `.env`.
#
# Le Worker Cloudflare utilise ses propres secrets via `wrangler
# secret put` (voir worker/.dev.vars.example pour le dev local).
# =============================================================

# --- D1 (base de données) ---
D1_DATABASE_NAME=beta-arsenal

# --- Auth maison (JWT) ---
# Secret JWT : 32+ octets aléatoires. Générez avec :
#   openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-bytes

# Compte admin bootstrappé par le seed (scripts/seed.mjs) :
ADMIN_BOOTSTRAP_EMAIL=odin10032@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=Henri@HAR0

# --- Moneero (paiement) ---
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_MODE=sandbox

# --- GitHub (stockage des images produits) ---
# Token PAT fine-grained avec permission "Contents: write" sur le dépôt.
# Créez-le sur : https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=beta-arsenal
GITHUB_BRANCH=main
GITHUB_IMAGE_PATH=public/uploads/products

# --- URLs publiques ---
PUBLIC_SITE_URL=https://beta-arsenal.pages.dev
WORKER_API_URL=https://beta-arsenal-api.your-subdomain.workers.dev
