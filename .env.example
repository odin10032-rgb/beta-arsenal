# =============================================================
# Bêta Arsenal - Exemple de variables d'environnement
# =============================================================
# Copiez ce fichier vers `.env` (pour le seed local) et/ou vers
# `worker/.dev.vars` (pour le développement local du Worker avec
# `wrangler dev`). Ne committez jamais le fichier réel `.env`.
# =============================================================

# --- Firebase (projet Firestore + Auth) ---
# L'ID du projet Firebase (ex: beta-arsenal)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Email du compte de service Firebase (ex: firebase-adminsdk-xxxx@beta-arsenal.iam.gserviceaccount.com)
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Clé privée du compte de service Firebase.
# Dans le fichier .env, gardez les \n tels quels ; le Worker les convertit en vraies nouvelles lignes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- FedaPay (paiement) ---
# Clé publique FedaPay (visible côté frontend, sandbox ou production)
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète FedaPay (backend uniquement)
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret utilisé pour vérifier la signature HMAC SHA-256 des webhooks FedaPay
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Uploadcare (fichiers numériques) ---
# Clé publique Uploadcare (utilisée par le widget frontend)
UPLOADCARE_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète Uploadcare (backend uniquement, pour signer les liens temporaires)
UPLOADCARE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin ---
# Email autorisé à se connecter au tableau de bord admin
ADMIN_EMAIL=admin@beta-arsenal.com

# --- URLs publiques ---
# URL publique du site (Cloudflare Pages), sans slash final
PUBLIC_SITE_URL=https://beta-arsenal.pages.dev
# URL publique du Worker (Cloudflare Workers), sans slash final
WORKER_API_URL=https://beta-arsenal-api.your-subdomain.workers.dev

# --- Firebase config (côté frontend - clés PUBLIQUES uniquement) ---
# Ces valeurs sont publiques par conception (Firebase Web Config).
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
