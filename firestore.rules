// =============================================================
// Bêta Arsenal - Règles de sécurité Firestore
// -------------------------------------------------------------
// Ces règles sont volontairement STRICTES :
//  - Les offres "actives" sont lisibles publiquement (catalogue).
//  - Aucune écriture directe côté client (tout passe par le Worker).
//  - Les transactions ne sont JAMAIS lisibles/écrivables par le client.
// =============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Collection `offers`
    // ---------------------------------------------------------
    // Lecture publique UNIQUEMENT des offres marquées `is_active == true`.
    // Aucune écriture côté client : le Worker (compte de service) gère tout.
    // ---------------------------------------------------------
    match /offers/{offerId} {
      // Lecture publique restreinte aux offres actives
      allow read: if resource.data.is_active == true;

      // Aucune création / modification / suppression côté client.
      // Les opérations d'écriture sont effectuées par le Worker via
      // l'API REST Firestore (compte de service Firebase).
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // Collection `transactions`
    // ---------------------------------------------------------
    // INTERDIT en lecture ET en écriture côté client.
    // Le statut d'une transaction est consulté via le Worker
    // (qui utilise un `public_token` opaque, pas l'ID Firestore).
    // ---------------------------------------------------------
    match /transactions/{transactionId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Règle par défaut : tout le reste est refusé.
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
